Auswertungen

ALLE auf einmal
git log --all --pretty=format:"%ad %an %s" --date=format:"%Y-%m-%d %H:%M:%S" --graph --decorate |
awk '
BEGIN {
    people["Thomas"]
    people["Jason"]
    people["Markus"]
}

{
    # --- explicit person time ---
    for (p in people) {
        if (match($0, (p " ?(-?[0-9]+([.,][0-9]+)?)[hH]?"), m)) {
            val = m[1]
            gsub(/,/, ".", val)
            people[p] += val + 0
            printf "Explizit für %s gezählt: %s => %+g\n", p, $0, val
        }
    }

    # --- shared "time" for all ---
    if (match($0, /time:? ?(-?[0-9]+([.,][0-9]+)?)[hH]?/, t)) {
        val = t[1]
        gsub(/,/, ".", val)

        for (p in people)
            people[p] += val + 0

        printf "Gemeinsam (time) für alle gezählt: %s => %+g\n", $0, val
    }
}

END {
    print "\n--- Summary ---"
    for (p in people)
        printf "%s: %.2f h\n", p, people[p]
}'




Thomas
git log --all --pretty=format:"%ad %an %s" --date=format:"%Y-%m-%d %H:%M:%S" --graph --decorate |
awk '
{
  sum = 0

  # Thomas <number>[h optional]
  if (match($0, /Thomas ?([0-9]+([.,][0-9]+)?)[hH]?/, m)) {
      val = m[1]
      gsub(/,/, ".", val)
      sum += val + 0
      printf "Explizit für Thomas gezählt: %s => +%s\n", $0, val
  }

  # time: <number>[h optional]
  if (match($0, /time:? ?([0-9]+([.,][0-9]+)?)[hH]?/, t)) {
      val = t[1]
      gsub(/,/, ".", val)
      sum += val + 0
      printf "Gemeinsam (time) für Thomas gezählt: %s => +%s\n", $0, val
  }

  if (sum > 0)
      thomas += sum
}
END {
  printf "\nThomas: %.2f h\n", thomas
}'



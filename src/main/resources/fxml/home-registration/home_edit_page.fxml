<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import at.jku.se.gruppe2.presentation.component.custom.IntegerField?>

<BorderPane prefHeight="600.0"
            prefWidth="640.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="at.jku.se.gruppe2.presentation.controller.home.HomeEditController">

    <top>
        <HBox spacing="10" styleClass="card">
            <Button text="Back to Dashboard" onAction="#handleDashboard"/>
        </HBox>
    </top>

    <!-- MAIN CONTAINER -->
    <center>
        <VBox alignment="TOP_CENTER"
              spacing="10"
              styleClass="card">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>

            <Label text="Edit Home Details">
                <font>
                    <Font size="20" />
                </font>
            </Label>

            <VBox spacing="0" HBox.hgrow="ALWAYS">
                <Label text="Home Name:"/>
                <TextField fx:id="homeLabel"/>
            </VBox>
            <VBox spacing="0" prefWidth="150">
                <Label text="Number of Floors:"/>
                <IntegerField fx:id="floorLevels"/>
            </VBox>

            <Separator />

            <Label text="Address Information">
                <font>
                    <Font size="15" />
                </font>
            </Label>

            <VBox spacing="0">
                <Label text="Address:"/>
                <HBox spacing="10">
                    <TextField fx:id="street" promptText="Street Name" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="streetNumber" promptText="Number" prefWidth="100"/>
                </HBox>
            </VBox>

            <VBox spacing="0">
                <HBox spacing="10">
                    <TextField fx:id="postalCode" promptText="Postal Code" prefWidth="150"/>
                    <TextField fx:id="city" promptText="City" HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <VBox spacing="0">
                <Label text="Country:"/>
                <ComboBox fx:id="countryBox" promptText="Country" prefWidth="Infinity"/>
            </VBox>

            <HBox alignment="TOP_RIGHT" spacing="10">
                <Button text="Cancel" onAction="#cancelButtonClicked"/>
                <Button text="Save Changes" onAction="#saveButtonClicked" defaultButton="true"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
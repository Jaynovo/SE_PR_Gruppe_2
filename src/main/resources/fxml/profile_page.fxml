<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="600.0" prefWidth="640.0"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="at.jku.se.gruppe2.ui.controller.ProfileController">

    <children>
        <VBox alignment="CENTER" maxWidth="360" spacing="12" styleClass="card">

            <!-- Titel -->
            <Label alignment="TOP_CENTER" text="Profil">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>

            <!-- Avatar -->
            <ImageView fx:id="avatarImage" fitHeight="80" fitWidth="80" preserveRatio="true" />

            <Button fx:id="changeAvatarButton" maxWidth="125" minWidth="-Infinity" onAction="#onChangeAvatar" prefHeight="25.0" prefWidth="90.0" text="Profilbild ändern" />

            <!-- Formular -->
            <VBox alignment="CENTER_LEFT" maxWidth="300" spacing="8">
                <Label text="First Name:" />
                <TextField fx:id="firstNameField" promptText="First Name" />

                <Label text="Last Name:" />
                <TextField fx:id="lastNameField" promptText="Last Name" />

                <Label text="E-Mail:" />
                <TextField fx:id="emailField" editable="false" promptText="E-Mail (Änderung der Email nicht möglich)" />

                <Label text="Street:" />
                <TextField fx:id="streetField" promptText="Address" />

                <Label text="Number:" />
                <TextField fx:id="streetNumberField" promptText="Nr:" />

                <Label text="Postal code:" />
                <TextField fx:id="postalCodeField" promptText="Postal Code" />

                <Label text="City:" />
                <TextField fx:id="cityField" promptText="City" />

                <Label text="Country:" />
                <ComboBox fx:id="countryComboBox" promptText="Country" />

                <Button fx:id="changePasswordButton" alignment="CENTER" maxWidth="Infinity" onAction="#onChangePassword" prefHeight="25.0" prefWidth="156.0" text="Passwort ändern" />
            </VBox>

            <!-- Buttons -->
            <HBox alignment="CENTER" spacing="12">
                <Button fx:id="cancelButton" onAction="#onCancel" text="Cancel" />

                <Button fx:id="saveButton" alignment="CENTER_RIGHT" onAction="#onSave" text="Save" />
            </HBox>

            <padding>
                <Insets bottom="16" left="16" right="16" top="16" />
            </padding>
        </VBox>
    </children>
</StackPane>

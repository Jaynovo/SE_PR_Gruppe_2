<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" prefWidth="650" prefHeight="500" styleClass="card" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="at.jku.se.gruppe2.ui.controller.ManageUsersDialogController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Manage Home Members" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="memberCountLabel" styleClass="muted"/>
    </HBox>

    <Separator/>

    <!-- Members List -->
    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="Current Members:" styleClass="card-title"/>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
            <VBox fx:id="membersContainer" spacing="8">
                <padding>
                    <Insets top="8" right="8" bottom="8" left="8"/>
                </padding>
                <Label fx:id="noMembersLabel" text="No members found"
                       styleClass="muted" visible="false"/>
            </VBox>
        </ScrollPane>
    </VBox>

    <!-- Action Buttons -->
    <Separator/>
    
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Refresh" onAction="#handleRefresh"/>
        <Button text="Close" onAction="#handleClose" defaultButton="true"/>
    </HBox>

</VBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="600.0" prefWidth="640.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="at.jku.se.gruppe2.ui.controller.DashboardController">

    <top>
        <ToolBar BorderPane.alignment="CENTER">
            <Label text="Smart Home Dashboard" styleClass="title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <MenuButton text="Manage User">
                <items>
                    <MenuItem text="Profile" onAction="#handleUserProfile"/>
                    <MenuItem text="Logout" onAction="#handleLogout"/>
                </items>
            </MenuButton>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Your Home:" styleClass="title" />

            <Label fx:id="temperatureLabel" text="Loading weather..." style="-fx-font-size: 14;" />

            <!-- Home display area -->
            <BorderPane fx:id="homeCard" visible="false" style="-fx-border-radius: 8;">
                <left>
                    <VBox spacing="8">

                        <Label text="Home Name: " />
                        <Label fx:id="homeName" text="Home Name: "/>
                        <Label fx:id="homeAddress" text="Address: "/>
                        <Label fx:id="homeFloors" text="Number of floors of your home: " />

                    </VBox>
                </left>

                <right>
                    <Button text="Open Home"  onAction="#openHomeDetails"/>
                </right>

<!--                Here a list of the rooms should be displayed-->
                <bottom>
                    <ScrollPane fitToWidth="true" pannable="true">

                        <FlowPane fx:id="cardsFlow" hgap="16" vgap="16">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>

                        </FlowPane>

                    </ScrollPane>
                </bottom>

            </BorderPane>

        </VBox>
    </center>

    <bottom>
        <FlowPane alignment="CENTER" >
            <Button text="Add a new home" onAction="#addHomeButtonClicked"/>
            <Button text="Delete a home" onAction="#deleteHomeButtonClicked" />
        </FlowPane>
    </bottom>
</BorderPane>

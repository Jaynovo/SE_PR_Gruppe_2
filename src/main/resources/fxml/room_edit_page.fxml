<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import at.jku.se.gruppe2.ui.custom.IntegerField?>

<BorderPane prefHeight="600.0"
            prefWidth="640.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="at.jku.se.gruppe2.ui.controller.RoomEditController">

    <top>
        <HBox spacing="10" styleClass="card">
            <Button text="Back to Dashboard" onAction="#handleBack"/>
        </HBox>
    </top>

    <!-- MAIN CONTAINER -->
    <center>
        <VBox alignment="TOP_CENTER"
              spacing="15"
              styleClass="card">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>

            <Label text="Edit Room Details">
                <font>
                    <Font size="20" />
                </font>
            </Label>

            <TextField fx:id="roomLabelField" promptText="Room Name:" />
            <IntegerField fx:id="floorField" promptText="Floor Number:" />

            <Separator />

            <Label text="Room Dimensions" styleClass="card-title"/>

            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Length (meters):"/>
                    <TextField fx:id="lengthField" promptText="e.g., 5.5"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Width (meters):"/>
                    <TextField fx:id="widthField" promptText="e.g., 4.0"/>
                </VBox>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Calculated Area:"/>
                <Label fx:id="areaLabel" text="--" style="-fx-font-weight: bold;"/>
            </HBox>

            <HBox alignment="TOP_RIGHT" spacing="10">
                <Button text="Cancel" onAction="#handleBack"/>
                <Button text="Save Changes" onAction="#handleSave" defaultButton="true"/>
            </HBox>

            <Separator />

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Danger Zone" styleClass="error-label"/>
            </HBox>
            <Button text="Delete Room"
                    onAction="#handleDelete"
                    styleClass="button, danger"
                    maxWidth="200"/>

        </VBox>
    </center>

</BorderPane>
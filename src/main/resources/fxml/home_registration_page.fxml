<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import at.jku.se.gruppe2.ui.custom.IntegerField?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<StackPane prefHeight="600.0"
           prefWidth="640.0"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="at.jku.se.gruppe2.ui.controller.HomeRegistrationController">

    <children>
        <!-- MAIN CONTAINER -->
        <VBox alignment="TOP_CENTER"
              spacing="15"
              styleClass="card">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>

            <Label text="Add a new Home">
                <font>
                    <Font size="20" />
                </font>
            </Label>

            <TextField fx:id="homeLabel" promptText="Name your Home:" />
            <IntegerField fx:id="floorLevels" promptText="Number of floors:" />

            <HBox spacing="10">
                <TextField fx:id="street" promptText="Street label:" HBox.hgrow="ALWAYS"/>
                <IntegerField fx:id="streetNumber" promptText="Number:" prefWidth="100"/>
            </HBox>

            <HBox spacing="10">
                <IntegerField fx:id="postalCode" promptText="Postal Code:" prefWidth="150" />
                <TextField fx:id="city" promptText="City:" HBox.hgrow="ALWAYS" />
            </HBox>

            <ComboBox fx:id="countryBox" promptText="Choose Country:" prefWidth="Infinity">

            </ComboBox>
            <!-- BUTTON ROW -->
            <HBox alignment="CENTER_RIGHT"
                  spacing="10">
                <Button fx:id="cancelButton" text="Cancel" onAction="#cancelButtonClicked"/>
                <Button fx:id="saveButton" text="Save Home" onAction="#saveButtonClicked"/>
            </HBox>
        </VBox>
    </children>
</StackPane>

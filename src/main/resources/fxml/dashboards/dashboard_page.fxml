<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="600.0" prefWidth="640.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="at.jku.se.gruppe2.ui.controller.DashboardController">

    <top>
        <ToolBar BorderPane.alignment="CENTER">
            <Label text="Smart Home Dashboard" styleClass="title"/>
            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="userRoleLabel"
                   text="Your Role: Guest"
                   visible="false"
                   style="-fx-padding: 0 15 0 0; -fx-font-weight: bold;"/>

            <MenuButton text="Manage User">
                <items>
                    <MenuItem text="Profile" onAction="#handleUserProfile"/>
                    <MenuItem text="Logout" onAction="#handleLogout"/>
                </items>
            </MenuButton>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Your Home:" styleClass="title" />

            <Label fx:id="temperatureLabel" text="Loading weather..." style="-fx-font-size: 14;" />

            <Button fx:id="addHomeButton"
                    text="Add a new Home"
                    onAction="#addHomeButtonClicked"
                    visible="false"
                    managed="false" />

            <Button fx:id="homeInvitationsButton"
                    text="Home Invitations"
                    onAction="#handleHomeInvitations"
                    visible="false"
                    managed="false"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>

            <!-- Home display area -->
            <BorderPane fx:id="homeCard" visible="false" styleClass="card">
                <top>
                    <HBox spacing="10" alignment="TOP_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Home Details" styleClass="card-title"/>
                            <HBox spacing="4" alignment="CENTER_LEFT">
                                <Label text="Name:" styleClass="muted" minWidth="70" maxWidth="70"/>
                                <Label fx:id="homeName" text="Loading..."/>
                            </HBox>
                            <HBox spacing="4" alignment="TOP_LEFT">
                                <Label text="Address:" styleClass="muted" minWidth="70" maxWidth="70"/>
                                <VBox spacing="0">
                                    <Label fx:id="homeAddressStreet" text="--"/>
                                    <Label fx:id="homeAddressCity" text="--"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="4" alignment="CENTER_LEFT">
                                <Label text="Floors:" styleClass="muted" minWidth="70" maxWidth="70"/>
                                <Label fx:id="homeFloors" text="--"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="8">
                            <Button fx:id="editHomeButton" text="Change Home Details" onAction="#changeHomeDetails"/>
                            <Button fx:id="shareHomeButton" text="Share Home" onAction="#shareHome"/>
                            <Button fx:id="deleteHomeButton" text="Delete Home" onAction="#deleteHomeButtonClicked"
                                    styleClass="danger"/>
                        </VBox>
                    </HBox>
                </top>

                <center>
                    <VBox spacing="8">
                        <padding>
                            <Insets top="16" right="0" bottom="0" left="0"/>
                        </padding>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label text="Rooms" styleClass="card-title"/>
                            <Pane HBox.hgrow="ALWAYS"/>
                            <Button fx:id="createRoomButton"
                                    text="+ New Room"
                                    onAction="#handleCreateRoom"/>
                        </HBox>

                        <ScrollPane fitToWidth="true" pannable="true" minHeight="450" maxHeight="450"
                                    style="-fx-background: transparent; -fx-background-color: transparent;">
                            <FlowPane fx:id="cardsFlow" hgap="16" vgap="16">
                                <padding>
                                    <Insets top="8" right="8" bottom="8" left="8"/>
                                </padding>
                            </FlowPane>
                        </ScrollPane>
                    </VBox>
                </center>
            </BorderPane>

        </VBox>
    </center>

</BorderPane>
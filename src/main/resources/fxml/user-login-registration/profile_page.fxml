<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="640.0"
            prefWidth="680.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="at.jku.se.gruppe2.presentation.controller.auth.ProfileController">

    <top>
        <HBox spacing="10" styleClass="card">
            <Button text="Dashboard" onAction="#onCancel"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" pannable="true">
                <content>
                    <VBox alignment="TOP_CENTER"
                          spacing="15"
                          styleClass="card">

                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <Label text="Profile">
                            <font>
                                <Font size="20"/>
                            </font>
                        </Label>
                        <VBox alignment="CENTER" spacing="10">
                            <ImageView fx:id="avatarImage"
                                       fitHeight="96"
                                       fitWidth="96"
                                       preserveRatio="false"
                                       smooth="true"/>

                            <HBox alignment="CENTER" spacing="10">
                                <Button fx:id="changeAvatarButton"
                                        text="Change picture"
                                        onAction="#onChangeAvatar"/>

                                <Button fx:id="removeAvatarButton"
                                        text="Remove"
                                        onAction="#onRemoveAvatar"/>
                            </HBox>
                        </VBox>

                        <TextField fx:id="firstNameField" promptText="First Name"/>
                        <TextField fx:id="lastNameField" promptText="Last Name"/>
                        <TextField fx:id="emailField" editable="false" promptText="E-Mail (cannot be changed)"/>

                        <HBox spacing="10">
                            <TextField fx:id="streetField" promptText="Street" HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="streetNumberField" promptText="Nr." prefWidth="110"/>
                        </HBox>

                        <HBox spacing="10">
                            <TextField fx:id="postalCodeField" promptText="Postal Code" prefWidth="150"/>
                            <TextField fx:id="cityField" promptText="City" HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <ComboBox fx:id="countryComboBox" promptText="Country" prefWidth="Infinity"/>

                        <Button fx:id="changePasswordButton"
                                text="Change password"
                                maxWidth="Infinity"
                                onAction="#onChangePassword"/>

                        <HBox alignment="TOP_RIGHT" spacing="10">
                            <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel"/>
                            <Button fx:id="saveButton" text="Save" onAction="#onSave" defaultButton="true"/>
                        </HBox>

                    </VBox>
                </content>
        </ScrollPane>
    </center>
</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import at.jku.se.gruppe2.presentation.component.custom.IntegerField?>

<StackPane prefHeight="600.0" prefWidth="640.0"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="at.jku.se.gruppe2.presentation.controller.auth.RegistrationController">

    <VBox alignment="CENTER"
          spacing="10"
          styleClass="card">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="Smart Home User Registration">
            <font>
                <Font size="15.0"/>
            </font>
        </Label>

        <HBox spacing="10">
            <VBox spacing="0" HBox.hgrow="ALWAYS">
                <Label text="First Name:"/>
                <TextField fx:id="firstNameField" promptText="First Name:"/>
            </VBox>
            <VBox spacing="0" HBox.hgrow="ALWAYS">
                <Label text="Last Name:"/>
                <TextField fx:id="lastNameField" promptText="Last Name:"/>
            </VBox>
        </HBox>

        <VBox spacing="0">
            <Label text="Address:"/>
            <HBox spacing="10">
                <TextField fx:id="streetNameField" promptText="Street Name:" HBox.hgrow="ALWAYS"/>
                <IntegerField fx:id="streetNumberField" promptText="Number:" prefWidth="100"/>
            </HBox>
        </VBox>

        <VBox spacing="0">
            <HBox spacing="10">
                <IntegerField fx:id="postalCodeField" promptText="PostalCode:" prefWidth="150"/>
                <TextField fx:id="cityField" promptText="City:" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox spacing="0">
            <Label text="Country:"/>
            <ComboBox fx:id="countryBox" promptText="Choose Country:" prefWidth="Infinity"/>
        </VBox>

        <VBox spacing="0">
            <Label text="E-Mail:"/>
            <TextField fx:id="emailField" promptText="E-Mail:"/>
        </VBox>

        <VBox spacing="0">
            <Label text="Password:"/>
            <PasswordField fx:id="passwordField" promptText="Password:"/>
        </VBox>

        <VBox spacing="0">
            <Label text="Confirm Password:"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password:"/>
        </VBox>

        <HBox alignment="TOP_CENTER"
              spacing="10">
            <Button text="Return to Login" onAction="#handleToLogin"/>
            <Button text="Register" onAction="#registrationButtonClicked" defaultButton="true"/>
        </HBox>

    </VBox>
</StackPane>
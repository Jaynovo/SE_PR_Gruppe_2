<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="at.jku.se.gruppe2.presentation.controller.room.RoomSettingsController">

    <Label text="Room Settings"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="140"/>
            <ColumnConstraints minWidth="200"/>
        </columnConstraints>

        <Label text="Room:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="roomLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Min Temperature (°C):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="minTempField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Max Temperature (°C):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="maxTempField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Save" onAction="#onSave"/>
        <Button text="Reset" onAction="#onReset"/>
    </HBox>

</VBox>
